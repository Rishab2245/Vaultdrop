# MongoDB Atlas connection string, including the database name.
# Atlas is a replica set, which the Exchange needs: moving Keys between two
# ghosts runs inside a transaction, and MongoDB only supports those on one.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vaultdrop?retryWrites=true&w=majority"

# Public origin, used to build shareable links.
NEXT_PUBLIC_SITE_URL="https://your-deployment.vercel.app"

# Shared secret for the scheduled sweep at /api/maintenance/sweep.
# On Vercel, set this and the platform sends it as a Bearer token on the cron.
CRON_SECRET="generate-a-long-random-string"

# Optional. A Bitcoin address for donations. The donation panel is hidden
# entirely unless this is set AND parses as a real address - there is no
# placeholder, because a wrong address sends money somewhere unrecoverable.
NEXT_PUBLIC_BTC_ADDRESS=""
