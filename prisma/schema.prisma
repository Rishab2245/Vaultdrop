// VaultDrop data model.
//
// Design rule: the server stores the minimum that makes the product work and
// nothing that identifies a person. There are no user accounts, no sessions,
// no IP addresses, and no email addresses anywhere in this schema.
//
// SQLite by default so the app runs with zero setup. Swap `provider` to
// "postgresql" for production; no other change is required (enums are modelled
// as validated strings precisely so both engines work).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A public confession on the Wall. Public by definition, so it is stored as
/// plaintext - encrypting something the whole world is meant to read would be
/// security theatre. Authorship is proved by a token the client keeps; we store
/// only its hash, so we can honour "delete mine" without knowing who "mine" is.
model WallSecret {
  id   String @id @default(cuid())
  body String

  /// One of the MOODS list in src/lib/constants.ts
  mood    String
  /// Index into the PALETTES gradient list, used for share cards.
  palette Int    @default(0)

  /// sha256 of the author's local delete-token. Irreversible, unlinkable.
  authorTokenHash String

  reactFelt Int @default(0)
  reactHug  Int @default(0)
  reactWhoa Int @default(0)
  reactSame Int @default(0)

  viewCount   Int     @default(0)
  reportCount Int     @default(0)
  hidden      Boolean @default(false)

  /// Time-decayed ranking score, recomputed on write.
  heat      Float    @default(0)
  createdAt DateTime @default(now())

  /// The author's ghost. Nullable because the Wall still accepts records from
  /// someone who has never claimed an identity - anonymity must not require
  /// registering first.
  ghostId String?
  ghost   Ghost?  @relation(fields: [ghostId], references: [id])

  /// A locked record shows `teaser` to everyone and `body` only to ghosts who
  /// have spent Keys opening it.
  isLocked  Boolean @default(false)
  teaser    String?
  priceKeys Int     @default(0)

  opensCount    Int @default(0)
  worthItCount  Int @default(0)
  notWorthCount Int @default(0)

  /// 64-bit SimHash of the normalised body, stored as a hex string. Used to
  /// catch someone reposting an existing secret to farm Keys.
  simhash String?

  reports Report[]
  opens   Open[]
  threads Thread[]

  @@index([hidden, heat])
  @@index([hidden, createdAt])
  @@index([ghostId, createdAt])
  @@index([simhash])
}

/// A zero-knowledge payload: either a one-off private link drop or a message
/// sent to someone's Inbox. The server holds ciphertext it cannot read - the
/// decryption key lives in the URL fragment (never transmitted) or is derived
/// via ECDH against a public key whose private half never leaves the browser.
model EncryptedDrop {
  id String @id @default(cuid())

  /// base64. AES-256-GCM ciphertext.
  ciphertext String
  /// base64. 12-byte AES-GCM nonce.
  iv         String

  /// base64 SPKI of the sender's ephemeral ECDH public key. Inbox messages only.
  senderPubKey String?

  /// base64. Present when the sender added a passphrase on top of the link key.
  passwordSalt String?

  inboxId String?
  inbox   Inbox?  @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  burnAfterRead Boolean   @default(false)
  readAt        DateTime?

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([inboxId, createdAt])
  @@index([expiresAt])
}

/// A named anonymous inbox. Holds a public key only; the matching private key
/// is generated in the owner's browser and never sent anywhere.
model Inbox {
  id     String @id @default(cuid())
  handle String @unique

  /// base64 SPKI, ECDH P-256.
  publicKey String

  /// sha256 of the owner's local claim token.
  ownerTokenHash String

  createdAt DateTime @default(now())

  messages EncryptedDrop[]
}

/// Abuse report against a Wall secret. Carries no reporter identity - the point
/// is the content, not who flagged it.
model Report {
  id           String     @id @default(cuid())
  wallSecretId String
  wallSecret   WallSecret @relation(fields: [wallSecretId], references: [id], onDelete: Cascade)

  /// One of the REPORT_REASONS list in src/lib/constants.ts
  reason    String
  createdAt DateTime @default(now())

  @@index([wallSecretId])
}

/// ---------------------------------------------------------------------------
/// The Exchange
/// ---------------------------------------------------------------------------

/// A persistent pseudonymous identity.
///
/// This is the one place the product holds something that survives a page
/// reload, and it exists because reputation and a Key balance cannot work
/// without continuity. It is still not an account: there is no email, no
/// password, no phone number, and no recovery path that runs through us. The
/// secret half lives in the owner's browser; we hold only its hash.
///
/// The codename is derived from the id, so it cannot be chosen, squatted, or
/// used to signal anything about the person behind it.
model Ghost {
  /// sha256 of the ghost's local secret, base64url. The secret never persists here.
  id       String @id
  codename String @unique

  /// base64 SPKI, ECDH P-256. Lets other ghosts encrypt a thread message to
  /// this one. The private half never leaves the owner's device.
  publicKey String

  /// Spendable balance. Keys are not money and are deliberately not cashable.
  keys Int @default(0)

  /// Reputation, earned only from opens that were confirmed worthwhile.
  opensReceived Int @default(0)
  worthItCount  Int @default(0)
  notWorthCount Int @default(0)

  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// UTC day of the last daily grant, so the grant cannot be farmed by reloading.
  lastGrantOn String?

  records  WallSecret[]
  ledger   LedgerEntry[]
  opens    Open[]
  authored Thread[]        @relation("ThreadAuthor")
  started  Thread[]        @relation("ThreadStarter")
  messages ThreadMessage[]

  @@index([keys])
}

/// Append-only history of every Key movement.
///
/// Append-only because a balance with no audit trail is impossible to defend
/// when someone says their Keys vanished - and because the escrow needs a
/// record of what is owed to whom.
model LedgerEntry {
  id      String @id @default(cuid())
  ghostId String
  ghost   Ghost  @relation(fields: [ghostId], references: [id], onDelete: Cascade)

  /// Signed. Negative is a spend.
  delta   Int
  /// Running balance after this entry, so history is reconstructable.
  balance Int

  /// One of LEDGER_REASONS in src/lib/economy.ts
  reason String
  /// The record or open this entry relates to, where there is one.
  refId  String?

  createdAt DateTime @default(now())

  @@index([ghostId, createdAt])
}

/// One ghost opening one locked record.
///
/// The Keys are taken immediately but held, not paid. They move to the author
/// only once the opener says the secret was worth it, or once the rating window
/// closes. Paying on open would reward a good teaser; the teaser is the one
/// part of a locked record nobody can verify before paying for it.
model Open {
  id       String     @id @default(cuid())
  secretId String
  secret   WallSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)
  ghostId  String
  ghost    Ghost      @relation(fields: [ghostId], references: [id], onDelete: Cascade)

  priceKeys Int

  /// 'escrow' | 'released' | 'refunded'
  status  String  @default("escrow")
  /// 'worth' | 'not_worth' | null while unrated
  verdict String?

  createdAt DateTime  @default(now())
  settledAt DateTime?

  @@unique([secretId, ghostId])
  @@index([status, createdAt])
  @@index([ghostId, createdAt])
}

/// A private thread opened by someone who marked "same" on a record.
///
/// The payoff for confessing something is discovering you are not the only
/// one. Messages are encrypted to each party's ECDH key, so the server routes
/// them without being able to read them.
model Thread {
  id       String     @id @default(cuid())
  secretId String
  secret   WallSecret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  authorGhostId  String
  author         Ghost  @relation("ThreadAuthor", fields: [authorGhostId], references: [id], onDelete: Cascade)
  starterGhostId String
  starter        Ghost  @relation("ThreadStarter", fields: [starterGhostId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())
  /// Either side can close a thread and stop further messages.
  closed        Boolean  @default(false)

  messages ThreadMessage[]

  @@unique([secretId, starterGhostId])
  @@index([authorGhostId, lastMessageAt])
  @@index([starterGhostId, lastMessageAt])
}

/// One encrypted message in a thread. Ciphertext only; see EncryptedDrop.
model ThreadMessage {
  id       String @id @default(cuid())
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderGhostId String
  sender        Ghost  @relation(fields: [senderGhostId], references: [id], onDelete: Cascade)

  ciphertext   String
  iv           String
  /// Ephemeral ECDH public key of the sender for this message.
  senderPubKey String

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}
